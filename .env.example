# Database API (PostgREST over HTTPS) — used locally; set the same vars in Vercel -> Settings -> Environment Variables
# The scheme (https://) is optional — it is added automatically if missing.
API_BASE_URL=https://api-central_db.shajibbd.online
API_TABLE=shajibbd

# Only needed if the endpoint is secured later (PostgREST apikey / Bearer token)
# API_KEY=

# Secret used to sign login session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=
